# Copie para .env (o .env não vai para o Git). Em desenvolvimento os valores padrão já funcionam;
# em produção, troque a senha.
POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=agendamento
POSTGRES_PORT=5433

# Só para docker-compose.prod.yml
API_PORT=8080
API_TAG=latest
AGENDAMENTO_FUSO_HORARIO=America/Sao_Paulo

# Segurança. Gere a chave com: openssl rand -base64 32 (nunca reaproveite a de desenvolvimento)
JWT_SEGREDO=
# Administrador criado na primeira subida (troque a senha depois do primeiro login)
ADMIN_EMAIL=
ADMIN_SENHA=
# Endereço do front-end, separado por vírgula se houver mais de um
CORS_ORIGENS=http://localhost:4200

# RabbitMQ, só para docker-compose.prod.yml. O broker não publica portas: só a API o alcança.
RABBITMQ_DEFAULT_USER=agendamento
RABBITMQ_DEFAULT_PASS=

# E-mails de reserva, remarcação e cancelamento. Sem MAIL_HOST a API sobe e só registra no log
# quem receberia cada e-mail. Em produção a conexão exige STARTTLS (porta 587).
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_SENHA=
MAIL_REMETENTE="Barbearia Tonelli <nao-responder@seudominio.com.br>"
